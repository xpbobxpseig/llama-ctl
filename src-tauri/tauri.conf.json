{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "llama-ctl",
  "version": "0.1.0",
  "identifier": "com.llama-ctl.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "llama.cpp 服务控制台",
        "width": 1080,
        "height": 820,
        "minWidth": 880,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; form-action 'none'; frame-src 'none'; base-uri 'none'; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "capabilities": [],
      "freezePrototype": true,
      "pattern": {
        "use": "brownfield"
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/llama_icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "compression": "lzma",
        "startMenuFolder": "llama-ctl"
      }
    }
  }
}
